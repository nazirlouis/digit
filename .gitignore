# Do not blanket-ignore model/firmware formats (.espdl, .tflite, .bin,
# .pt, .onnx) or their metadata. Deployable models belong in xiao-sense/models/;
# model-training/.gitignore excludes intermediate training runs and exports.

# Measured wheel travel belongs to the physical Zumo, not shared defaults.
/zumo-controller/distance_calibration.json
/zumo-controller/distance_calibration_run.json
